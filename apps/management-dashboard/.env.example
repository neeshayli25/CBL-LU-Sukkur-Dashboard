# Prefer same-origin proxy in local/Cursor (vite proxies /api → backend:5000)
VITE_API_URL=/api/v1

# true = local preview login (seeded superadmin password → real JWT)
# false = Microsoft SSO + POST /auth/verify-email
VITE_BYPASS_AUTH=true
VITE_PREVIEW_EMAIL=superadmin@cblapp.com
VITE_PREVIEW_PASSWORD=Admin@123!

VITE_MSAL_CLIENT_ID=your_entra_app_client_id
VITE_MSAL_TENANT_ID=your_entra_tenant_id
