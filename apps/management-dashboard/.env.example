# Backend API (Sequelize Express server)
VITE_API_URL=http://localhost:5000/api/v1

# Preview-only UI mode — NEVER enable in production.
# true  = fake in-memory user, no JWT sent (backend returns 401 — expected)
# false = real Microsoft SSO + POST /auth/verify-email against the live API
VITE_BYPASS_AUTH=false

# Microsoft Entra ID (Azure AD) — required when VITE_BYPASS_AUTH=false
VITE_MSAL_CLIENT_ID=your_entra_app_client_id
VITE_MSAL_TENANT_ID=your_entra_tenant_id
# Optional authority override (defaults to https://login.microsoftonline.com/<tenant>)
# VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/your_tenant_id
