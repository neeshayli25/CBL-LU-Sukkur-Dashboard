# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=CBL-Backend
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Database (MySQL) — use 127.0.0.1 (not localhost) on Linux
# when the unix socket rejects non-root local connections.
# ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cbl_db
DB_USER=root
DB_PASSWORD=secret
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# ─────────────────────────────────────────────
# JWT — generate with: npm run generate:key
# Each secret must be at least 16 characters.
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_VERIFY_SECRET=change_me_verify_secret_min_32_chars
JWT_RESET_SECRET=change_me_reset_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_VERIFY_EXPIRY=24h
JWT_RESET_EXPIRY=1h

# ─────────────────────────────────────────────
# Redis (optional — rate limiting / cache / queues)
# App starts cleanly if Redis is down (non-fatal).
# ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=CBL App
MAIL_FROM_EMAIL=noreply@cblapp.com
SENDGRID_API_KEY=

# ─────────────────────────────────────────────
# File Storage
# ─────────────────────────────────────────────
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─────────────────────────────────────────────
# CORS — include the Vite dashboard origin
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# Encryption — MUST be exactly 32 characters
# ─────────────────────────────────────────────
ENCRYPTION_KEY=12345678901234567890123456789012
